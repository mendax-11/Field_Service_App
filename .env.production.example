# TimberFlow FSM — Production Environment
# Domain: https://assembly.vikifurniture.com

# PocketBase public URL on your FSM VPS.
# Option A: Direct port (if firewall allows 8090 publicly)
VITE_POCKETBASE_URL=https://assembly.vikifurniture.com:8090

# Option B: If you proxy PocketBase through Nginx on a subdomain:
# VITE_POCKETBASE_URL=https://pb.vikifurniture.com

# Option C: If you proxy PocketBase via Nginx path on same domain:
# VITE_POCKETBASE_URL=https://assembly.vikifurniture.com/pb
